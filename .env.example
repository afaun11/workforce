# =========================================================
# WFM MEDIKA - KONFIGURASI DATABASE GITHUB & VERCEL
# =========================================================

# GitHub Personal Access Token (PAT) dengan izin 'repo' (Contents Read/Write)
# Dapatkan token di https://github.com/settings/tokens (classic token dengan scope 'repo')
GITHUB_TOKEN=

# Username atau Organisasi GitHub tempat repository database berada
GITHUB_OWNER=

# Nama repository GitHub yang digunakan sebagai database (misal: wfm-medika-db)
GITHUB_REPO=

# Branch repository yang dituju (default: main)
GITHUB_BRANCH=main

# Path direktori penyimpanan data di dalam repo GitHub (default: data)
GITHUB_DATA_PATH=data

# Secret Key untuk Session Cookies
JWT_SECRET=medika_wfm_secret_key_2026_secure
